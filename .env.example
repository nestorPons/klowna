# Copia este archivo como .env y ajusta los valores.
DB_ROOT_PASSWORD=rootpass
DB_NAME=klowna
DB_USER=klowna
DB_PASSWORD=klownapass

# Credenciales del panel interno /admin/leads
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Puertos publicados en el host
APP_PORT=8080
DB_HOST_PORT=3307

# SMTP para los avisos del formulario de contacto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# Cloudflare Turnstile (la clave pública es visible en el HTML)
TURNSTILE_SITE_KEY=0x4AAAAAAFsU9zRaPwnUXFLc
TURNSTILE_SECRET=
# Solo desarrollo: true desactiva la validación del captcha
TURNSTILE_SKIP=false
